#!/usr/bin/env python3
"""
scripts/status_meter.py

Adds (and keeps up to date) a "Status Meter" section in the repository README.

The meter is rendered between two HTML comment markers so the script is
idempotent and can safely be run repeatedly (e.g. from CI):

    <!-- STATUS-METER:START -->
    ... generated content ...
    <!-- STATUS-METER:END -->

Usage:
    python scripts/status_meter.py                 # update README.md
    python scripts/status_meter.py --readme path   # custom README
    python scripts/status_meter.py --check         # exit 1 if out of date
    python scripts/status_meter.py --dry-run       # print, don't write
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

START_MARKER = "<!-- STATUS-METER:START -->"
END_MARKER = "<!-- STATUS-METER:END -->"

REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_README = REPO_ROOT / "README.md"

# Optional data sources that may exist in the repo. The script degrades
# gracefully when none of them are present.
DATA_CANDIDATES = (
    REPO_ROOT / "data" / "bounties.json",
    REPO_ROOT / "bounties.json",
    REPO_ROOT / "scripts" / "bounties.json",
)


def render_bar(current: float, total: float, width: int = 20) -> str:
    """Render an ASCII progress bar such as `████████░░░░ 40%`."""
    if total <= 0:
        ratio = 0.0
    else:
        ratio = max(0.0, min(1.0, current / total))

    filled = int(round(ratio * width))
    filled = max(0, min(width, filled))
    bar = "█" * filled + "░" * (width - filled)
    return f"`{bar}` {ratio * 100:5.1f}%"


def load_bounties() -> list[dict]:
    """Best-effort load of bounty records from the first existing source."""
    for path in DATA_CANDIDATES:
        if path.is_file():
            try:
                with path.open("r", encoding="utf-8") as fh:
                    data = json.load(fh)
                if isinstance(data, dict):
                    data = data.get("bounties", data.get("items", []))
                if isinstance(data, list):
                    return [item for item in data if isinstance(item, dict)]
            except (json.JSONDecodeError, OSError) as exc:  # pragma: no cover
                print(f"warning: could not read {path}: {exc}", file=sys.stderr)
    return []


def summarize(bounties: list[dict]) -> dict:
    """Reduce a list of bounty dicts into simple counters."""
    total = len(bounties)
    claimed = 0
    done = 0
    reward = 0.0

    for b in bounties:
        status = str(b.get("status", "")).strip().lower()
        if status in {"claimed", "in_progress", "claimed_locked"}:
            claimed += 1
        if status in {"done", "closed", "resolved", "merged", "paid"}:
            done += 1

        amount = b.get("reward_usd", b.get("reward", b.get("amount", 0)))
        try:
            reward += float(amount)
        except (TypeError, ValueError):
            pass

    open_count = max(0, total - claimed - done)
    return {
        "total": total,
        "open": open_count,
        "claimed": claimed,
        "done": done,
        "reward": reward,
    }


def build_meter(stats: dict) -> str:
    total = stats["total"]
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    if total == 0:
        body = (
            "> _No bounty data found yet — the meter will fill in as "
            "bounties are tracked._\n"
        )
    else:
        done_ratio = stats["done"]
        claimed_ratio = stats["claimed"]
        body = (
            "| Metric | Progress |\n"
            "| :----- | :------- |\n"
            f"| ✅ Completed | {render_bar(done_ratio, total)} "
            f"({done_ratio}/{total}) |\n"
            f"| 🚧 Claimed | {render_bar(claimed_ratio, total)} "
            f"({claimed_ratio}/{total}) |\n"
            f"| 🆕 Open | {render_bar(stats['open'], total)} "
            f"({stats['open']}/{total}) |\n"
        )

    lines = [
        START_MARKER,
        "## 📊 Status Meter",
        "",
        "<!-- This section is auto-generated by scripts/status_meter.py -->",
        "",
    ]
    lines.append(body.rstrip("\n"))
    lines.append("")
    lines.append(
        f"**Total tracked:** {total} &nbsp;·&nbsp; "
        f"**Reward pool:** ${stats['reward']:,.2f}"
    )
    lines.append("")
    lines.append(f"_Last updated: {now}_")
    lines.append("")
    lines.append(END_MARKER)
    return "\n".join(lines)


def inject(readme_text: str, block: str) -> str:
    """Insert/replace the meter block, appending if markers are missing."""
    pattern = re.compile(
        re.escape(START_MARKER) + r".*?" + re.escape(END_MARKER),
        re.DOTALL,
    )
    if pattern.search(readme_text):
        return pattern.sub(lambda _m: block, readme_text, count=1)

    # No markers found: append at the end of the README.
    if readme_text and not readme_text.endswith("\n"):
        readme_text += "\n"
    if readme_text and not readme_text.endswith("\n\n"):
        readme_text += "\n"
    return readme_text + block + "\n"


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Update the README status meter.")
    parser.add_argument(
        "--readme",
        default=os.environ.get("STATUS_METER_README", str(DEFAULT_README)),
        help="Path to the README file to update.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Exit non-zero if the README is out of date.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the result instead of writing it.",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    readme_path = Path(args.readme)

    if readme_path.is_file():
        readme_text = readme_path.read_text(encoding="utf-8")
    else:
        readme_text = ""
        print(f"note: {readme_path} does not exist, creating it", file=sys.stderr)

    stats = summarize(load_bounties())
    block = build_meter(stats)
    updated = inject(readme_text, block)

    if args.dry_run:
        print(updated)
        return 0

    if args.check:
        if updated != readme_text:
            print(
                "README status meter is out of date. "
                "Run `python scripts/status_meter.py`.",
                file=sys.stderr,
            )
            return 1
        print("README status meter is up to date.")
        return 0

    if updated != readme_text:
        readme_path.parent.mkdir(parents=True, exist_ok=True)
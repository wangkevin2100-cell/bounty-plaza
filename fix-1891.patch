#!/usr/bin/env python3
# FIX: Make the bounty watcher create one issue per newly discovered bounty,
# persist seen bounty IDs so pre-existing/open bounties are not re-announced
# in a single aggregate issue, and correctly de-duplicate using algora IDs.

"""
hunt_bounties.py
----------------
Polls configured GitHub repositories for open bounty issues and emits a
dedicated GitHub issue for *each* newly discovered bounty.

The previous behaviour bundled every bounty that was already open when the
watcher started into a single "📋 N open bounties right now" issue, which:
  * produced noisy/duplicated announcements on every restart, and
  * could not be closed/tracked per-bounty.

This version keeps a persistent state file of bounty identifiers that have
already been announced. On first run it seeds the state without spamming,
and on every subsequent run it opens exactly one issue per new bounty.
"""

from __future__ import annotations

import json
import logging
import os
import re
import sys
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional

import requests

logging.basicConfig(
    level=os.getenv("LOG_LEVEL", "INFO"),
    format="%(asctime)s %(levelname)s %(name)s: %(message)s",
)
log = logging.getLogger("hunt_bounties")

GITHUB_API = "https://api.github.com"
STATE_FILE = Path(os.getenv("BOUNTY_STATE_FILE", ".bounty_state.json"))
ISSUE_REPO = os.getenv("BOUNTY_ISSUE_REPO", "zhangjiayang6835-cyber/bounty-plaza")
DEFAULT_LABELS = [l for l in os.getenv("BOUNTY_LABELS", "bounty,real").split(",") if l]

# Match algora bounty markers like <!-- algora:gh-4455330769 -->
ALGORA_RE = re.compile(r"<!--\s*algora:gh-(\d+)\s*-->")
# Match "🔴 **$150** · [title](url)" lines
BOUNTY_LINE_RE = re.compile(
    r"🔴\s*\*\*\$(?P<amount>[\d,]+)\*\*\s*·\s*\[(?P<title>[^\]]+)\]\((?P<url>[^)]+)\)"
)
# Extract org/repo/issues/N from a GitHub URL
ISSUE_URL_RE = re.compile(
    r"https?://github\.com/(?P<owner>[^/]+)/(?P<repo>[^/]+)/issues/(?P<number>\d+)"
)


@dataclass
class Bounty:
    """A single open bounty discovered on GitHub."""

    key: str  # stable unique id, e.g. "org/repo#123"
    url: str
    title: str
    amount: Optional[str] = None
    algora_id: Optional[str] = None
    labels: List[str] = field(default_factory=list)

    def __hash__(self) -> int:
        return hash(self.key)

    def __eq__(self, other: object) -> bool:
        return isinstance(other, Bounty) and self.key == other.key


def _session() -> requests.Session:
    s = requests.Session()
    token = os.getenv("GITHUB_TOKEN") or os.getenv("GH_TOKEN")
    if not token:
        log.warning("No GITHUB_TOKEN/GH_TOKEN set - API access will be rate limited.")
    else:
        s.headers.update(
            {
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
            }
        )
    s.headers.setdefault("User-Agent", "bounty-plaza-hunter/1.0")
    return s


def load_state(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {"seen": [], "seeded": False}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError) as exc:
        log.warning("Could not read state file %s: %s", path, exc)
        return {"seen": [], "seeded": False}
    if isinstance(data, list):  # backward compatibility
        data = {"seen": data, "seeded": True}
    data.setdefault("seen", [])
    data.setdefault("seeded", False)
    return data


def save_state(path: Path, state: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")
    tmp.replace(path)


def parse_issue_body(body: str) -> List[Bounty]:
    """Parse bounty lines (and algora markers) out of an aggregate issue body."""
    found: List[Bounty] = []
    if not body:
        return found

    # Map algora numeric ids -> bounty (only used as a fallback key).
    algora_ids: List[str] = ALGORA_RE.findall(body)

    for m in BOUNTY_LINE_RE.finditer(body):
        url = m.group("url").strip()
        issue_match = ISSUE_URL_RE.search(url)
        if issue_match:
            key = "{owner}/{repo}#{number}".format(**issue_match.groupdict())
        else:
            key = url
        found.append(
            Bounty(
                key=key,
                url=url,
                title=m.group("title").strip(),
                amount=m.group("amount").replace(",", ""),
                algora_id=algora_ids.pop(0) if algora_ids else None,
            )
        )

    # Fallback: if the body only has algora markers, still record them.
    if not found:
        for aid in algora_ids:
            found.append(
                Bounty(
                    key=f"algora:gh-{aid}",
                    url=ISSUE_URL_RE.search(body).group(0) if ISSUE_URL_RE.search(body) else "",
                    title="bounty",
                    algora_id=aid,
                )
            )
    return found


def fetch_open_bounties(session: requests.Session, repos: Iterable[str], labels: List[str]) -> List[Bounty]:
    """Query each repo for open issues carrying the bounty label(s)."""
    bounties: List[Bounty] = []
    label_query = ",".join(labels) if labels else "bounty"
    for repo in repos:
        page = 1
        while True:
            url = f"{GITHUB_API}/repos/{repo}/issues"
            params = {
                "state": "open",
                "labels": label_query,
                "per_page": 100,
                "page": page,
            }
            resp = session.get(url, params=params, timeout=30)
            if resp.status_code == 404:
                log.warning("Repo %s not found - skipping.", repo)
                break
            resp.raise_for_status()
            items = resp.json()
            if not items:
                break
            for item in items:
                # PRs also come back through the issues endpoint.
                if "pull_request" in item:
                    continue
                body = item.get("body") or ""
                aid = ALGORA_RE.search(body)
                bounties.append(
                    Bounty(
                        key=f"{repo}#{item['number']}",
                        url=item